#!/usr/bin/env bash

set -euo pipefail

#
# Consts/Vars

readonly VERSION='2.0.0'

readonly OH_MODULES="${OH_MODULES:-"${HOME}/.local/lib/oh"}"
export OH_MODULES

readonly EX_INVALID_CALL=2
readonly EX_NOT_EXECUTABLE=126
readonly EX_NOT_FOUND=127

#
# Functions

usage() {
    printf '%s\n' \
        "Usage:" \
        "    ${0##*/} [options]" \
        "    ${0##*/} <module> [args...]" \
        "" \
        "Options:" \
        "    -l, --list     List available modules." \
        "    -v, --version  Show version information and exit." \
        "    -h, --help     Show this help message and exit." \
        "" \
        "Environment:" \
        "    OH_MODULES     Module directory (default: \$HOME/.local/lib/oh)." \
        "" \
        "Module dispatch:" \
        "    No args after <module>, or an arg starting with '-', runs:" \
        "        ${0##*/} <module> <module> [args...]" \
        "" \
        "    Otherwise, the first arg is the command name:" \
        "        ${0##*/} <module> <command> [args...]" \
        "" \
        "    Remaining args are passed to the selected executable."
}

die() {
    local exit_code=$1
    shift

    local message
    printf -v message '%s' "${0##*/}"

    local msg
    for msg in "$@"; do
        printf -v message '%s: %s' "$message" "$msg"
    done

    printf '%s\n' "$message" >&2
    exit "$exit_code"
}

list_modules() {
    if [[ ! -d $OH_MODULES ]]; then
        printf 'No modules installed.\n'
        return 0
    fi

    local modules
    modules=$(
        find "$OH_MODULES" \
            -mindepth 1 \
            -maxdepth 1 \
            \( -type d -o -type l \) \
            -printf '    %f\n' |
            sort
    )

    if [[ -z $modules ]]; then
        printf 'No modules installed.\n'
        return 0
    fi

    printf 'Modules:\n'
    printf '%s\n' "$modules"
}

run() {
    local module=$1
    shift
    [[ $module =~ ^[a-z0-9_-]+$ ]] ||
        die "$EX_INVALID_CALL" "invalid module" "$module"

    local module_dir="$OH_MODULES/$module"
    [[ -d $module_dir ]] ||
        die "$EX_NOT_FOUND" "module not found" "$module"

    # The module name is also the name of its default command.
    #
    # A non-flag argument is treated as a command only when an executable
    # command with that name exists in the module. Otherwise, it is passed
    # to the module's default command.
    #
    # `--` explicitly selects the default command and passes all remaining
    # arguments through without attempting command dispatch.
    #
    # Cases:
    #   oh module cmd [args...]  -> module/cmd [args...], if cmd exists
    #   oh module arg [args...]  -> module/module arg [args...]
    #   oh module -f             -> module/module -f
    #   oh module --flag         -> module/module --flag
    #   oh module -- cmd         -> module/module cmd
    local cmd=$module
    if [[ $# -gt 0 && $1 == '--' ]]; then
        # Explicitly use the default command and pass all remaining arguments through.
        shift
    elif [[ $# -gt 0 && ${1:0:1} != '-' ]]; then
        local second_arg=$1

        [[ $second_arg =~ ^[a-z0-9_-]+$ ]] ||
            die "$EX_INVALID_CALL" "invalid command" "$module $second_arg"

        local cmd_path="$module_dir/$second_arg"

        if [[ -x $cmd_path ]]; then
            # Consume the argument when it names an executable command.
            cmd=$second_arg
            shift
        fi
    fi

    local cmd_name=" $cmd"
    local cmd_path="$module_dir/$cmd"

    [[ -e $cmd_path ]] ||
        die "$EX_NOT_FOUND" "command not found" "$module$cmd_name"

    [[ -f $cmd_path ]] ||
        die "$EX_INVALID_CALL" "not an executable command" "$module$cmd_name"

    [[ -x $cmd_path ]] ||
        die "$EX_NOT_EXECUTABLE" "command is not executable" "$module$cmd_name"

    exec "$cmd_path" "$@"
}

main() {
    case "${1:-}" in
    -l | --list )
        list_modules
        ;;
    -v | --version)
        printf '%s version %s\n' "${0##*/}" "$VERSION"
        ;;
    -h | --help | "")
        usage
        ;;
    -*)
        printf 'Unknown option: %s\n' "$1" >&2
        usage >&2
        exit "$EX_INVALID_CALL"
        ;;

    *)
        run "$@"
        ;;
    esac
}

#
# Entry point

main "$@"
